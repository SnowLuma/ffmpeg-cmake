{
  "presets": {
    "media": [
      "zlib",
      "opus",
      "vorbis",
      "webp",
      "freetype",
      "harfbuzz"
    ],
    "all": [
      "zlib",
      "opus",
      "vorbis",
      "webp",
      "freetype",
      "harfbuzz",
      "aom",
      "x265",
      "xz",
      "sdl2"
    ]
  },
  "libraries": {
    "zlib": {
      "repository": "https://github.com/madler/zlib.git",
      "revision": "da607da739fa6047df13e66a2af6b8bec7c2a498",
      "version": "1.3.2",
      "options": {
        "ZLIB_BUILD_SHARED": "OFF",
        "ZLIB_BUILD_STATIC": "ON",
        "ZLIB_BUILD_TESTING": "OFF",
        "ZLIB_INSTALL": "ON"
      },
      "licenses": [
        "LICENSE"
      ]
    },
    "opus": {
      "repository": "https://github.com/xiph/opus.git",
      "revision": "22244de5a79bd1d6d623c32e72bf1954b56235be",
      "version": "1.6.1",
      "options": {
        "OPUS_BUILD_PROGRAMS": "OFF",
        "OPUS_BUILD_TESTING": "OFF",
        "OPUS_INSTALL_PKG_CONFIG_MODULE": "ON",
        "OPUS_INSTALL_CMAKE_CONFIG_MODULE": "ON"
      },
      "licenses": [
        "COPYING"
      ]
    },
    "ogg": {
      "repository": "https://github.com/xiph/ogg.git",
      "revision": "be05b13e98b048f0b5a0f5fa8ce514d56db5f822",
      "version": "1.3.6",
      "options": {
        "INSTALL_DOCS": "OFF"
      },
      "licenses": [
        "COPYING"
      ]
    },
    "vorbis": {
      "repository": "https://github.com/xiph/vorbis.git",
      "revision": "0657aee69dec8508a0011f47f3b69d7538e9d262",
      "version": "1.3.7",
      "requires": [
        "ogg"
      ],
      "licenses": [
        "COPYING"
      ]
    },
    "webp": {
      "repository": "https://github.com/webmproject/libwebp.git",
