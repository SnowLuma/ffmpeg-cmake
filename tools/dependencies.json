      "requires": [
        "freetype"
      ]
    },
    "aom": {
      "repository": "https://aomedia.googlesource.com/aom",
      "revision": "03087864cf4bea6abb0d28f95cf7843511413d8f",
      "version": "3.14.1",
      "options": {
        "ENABLE_TESTS": "OFF",
        "ENABLE_DOCS": "OFF",
        "ENABLE_EXAMPLES": "OFF",
        "ENABLE_TOOLS": "OFF"
      },
      "licenses": [
        "LICENSE",
        "PATENTS"
      ]
    },
    "x265": {
      "repository": "https://github.com/Multicorewareinc/x265.git",
      "revision": "e9b88125dc21393b3fd8d68e98083bdfb89778a8",
      "version": "4.3",
      "source_subdir": "source",
      "gpl": true,
      "options": {
        "ENABLE_SHARED": "OFF",
        "ENABLE_CLI": "OFF",
        "ENABLE_LIBNUMA": "OFF",
        "ENABLE_PIC": "ON",
        "ENABLE_SVT_HEVC": "OFF"
      },
      "licenses": [
        "COPYING"
      ],
      "tag": "4.3"
    },
    "xz": {
      "repository": "https://github.com/tukaani-project/xz.git",
      "revision": "4b73f2ec19a99ef465282fbce633e8deb33691b3",
      "version": "5.8.3",
      "options": {
        "XZ_TOOL_XZ": "OFF",
        "XZ_TOOL_XZDEC": "OFF",
        "XZ_TOOL_LZMADEC": "OFF",
        "XZ_TOOL_LZMAINFO": "OFF",
        "XZ_DOC": "OFF"
      },
      "licenses": [
        "COPYING",
        "COPYING.0BSD"
      ]
    },
    "sdl2": {
      "repository": "https://github.com/libsdl-org/SDL.git",
      "revision": "5d249570393f7a37e037abf22cd6012a4cc56a71",
      "version": "2.32.10",
      "options": {
        "SDL_SHARED": "OFF",
        "SDL_STATIC": "ON",
        "SDL_TEST": "OFF",
        "SDL_TESTS": "OFF"
      },
      "licenses": [
        "LICENSE.txt"
      ]
    }
  }
}
