        "WEBP_BUILD_EXTRAS": "OFF",
        "WEBP_BUILD_LIBWEBPMUX": "ON"
      },
      "licenses": [
        "COPYING",
        "PATENTS"
      ]
    },
    "freetype": {
      "repository": "https://github.com/freetype/freetype.git",
      "revision": "0a0221a1347e2f1e07c395263540026e9a0aa7c7",
      "version": "2.14.3",
      "requires": [
        "zlib"
