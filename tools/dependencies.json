        "FT_DISABLE_PNG": "ON",
        "FT_DISABLE_HARFBUZZ": "ON",
        "FT_DISABLE_BROTLI": "ON",
        "FT_REQUIRE_ZLIB": "ON"
      },
      "licenses": [
        "LICENSE.TXT",
        "docs/FTL.TXT",
        "docs/GPLv2.TXT"
      ]
    },
    "harfbuzz": {
      "repository": "https://github.com/harfbuzz/harfbuzz.git",
      "revision": "36cb489cb02ce4b92099669ba9f9bea348eff93f",
      "version": "14.4.0",
      "options": {
        "HB_BUILD_UTILS": "OFF",
        "HB_BUILD_SUBSET": "OFF",
        "HB_HAVE_FREETYPE": "ON",
        "HB_HAVE_GLIB": "OFF",
        "HB_HAVE_ICU": "OFF",
        "HB_HAVE_CAIRO": "OFF",
        "HB_BUILD_RASTER": "OFF",
        "HB_BUILD_VECTOR": "OFF",
        "HB_BUILD_GPU": "OFF",
        "HB_HAVE_CORETEXT": "OFF"
