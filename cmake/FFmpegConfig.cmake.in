@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@ZLIB_FOUND@)
  if(@FF_CONFIG_ZLIB_STATIC@)
    find_dependency(ZLIB CONFIG COMPONENTS static)
    if(NOT TARGET ZLIB::ZLIB)
      add_library(ZLIB::ZLIB ALIAS ZLIB::ZLIBSTATIC)
    endif()
  else()
    find_dependency(ZLIB)
  endif()
endif()
if(@BZIP2_FOUND@)
  find_dependency(BZip2)
endif()
if(@LIBLZMA_FOUND@)
  find_dependency(LibLZMA)
  if(WIN32 AND @FFMPEG_HAVE_DEPENDENCY_PREFIX@)
    set_property(TARGET LibLZMA::LibLZMA APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS LZMA_API_STATIC)
  endif()
endif()
if(@Iconv_FOUND@)
  find_dependency(Iconv)
endif()
if(@CONFIG_OPENSSL@)
  find_dependency(OpenSSL)
endif()
if(@ALSA_FOUND@)
  find_dependency(ALSA)
endif()
if(NOT WIN32)
  find_dependency(Threads)
endif()
set(FF_REQUIRED_PACKAGES "@FF_REQUIRED_PACKAGES@")
set(FF_EXTERNAL_GPL "@FF_EXTERNAL_GPL@")
set(FF_EXTERNAL_PKGCONFIG "@FF_EXTERNAL_PKGCONFIG@")
include("${CMAKE_CURRENT_LIST_DIR}/ExternalPackages.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/FFmpegTargets.cmake")
foreach(component IN LISTS FFmpeg_FIND_COMPONENTS)
  if(TARGET FFmpeg::${component})
    set(FFmpeg_${component}_FOUND TRUE)
  else()
    set(FFmpeg_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(FFmpeg)
