ff_probe(HAVE_IDXGIOUTPUT5 "#include <windows.h>\n#include <dxgi1_5.h>\nint main(void) { IDXGIOutput5 *p = 0; return p != 0; }")
ff_probe(HAVE_DPI_AWARENESS_CONTEXT "#include <windows.h>\nint main(void) { return sizeof(DPI_AWARENESS_CONTEXT) == 0; }")
ff_probe(IBaseFilter "#include <dshow.h>\nint main(void) { IBaseFilter *p = 0; return p != 0; }")
list(APPEND CMAKE_REQUIRED_LIBRARIES gdi32 vfw32 mfplat mfuuid)
ff_probe(CreateDIBSection "#include <windows.h>\nint main(void) { return CreateDIBSection(0, 0, 0, 0, 0, 0) != 0; }")
ff_probe(vfw32 "#include <windows.h>\n#include <vfw.h>\nint main(void) { return capCreateCaptureWindowA(0, 0, 0, 0, 0, 0, 0, 0) != 0; }")
ff_probe(vfwcap_defines "#include <windows.h>\n#include <vfw.h>\n_Static_assert(WM_CAP_DRIVER_CONNECT > WM_USER, \"VFW API\");\nint main(void) { return 0; }")
ff_probe(mftransform_h "#include <windows.h>\n#include <mftransform.h>\nint main(void) { return 0; }")
ff_probe(MFCreateAlignedMemoryBuffer "#include <windows.h>\n#include <mfapi.h>\nint main(void) { return MFCreateAlignedMemoryBuffer(0, 0, 0); }")
if(mftransform_h AND MFCreateAlignedMemoryBuffer)
  ff_fact(CONFIG_MEDIAFOUNDATION 1)
endif()
